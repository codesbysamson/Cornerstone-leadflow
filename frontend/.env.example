# Copy this file to .env to configure the frontend locally.
# .env is git-ignored and must not be committed.

# Base URL of the Cornerstone LeadFlow API.
# The default below matches the FastAPI dev server started with
#   uvicorn app.main:app --reload
# from the backend/ directory.
VITE_API_BASE_URL=http://127.0.0.1:8000
