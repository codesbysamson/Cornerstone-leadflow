# Copy this file to .env to configure the frontend locally.
# .env is git-ignored and must not be committed.

# Base URL of the Cornerstone LeadFlow API.
#
# It must use the SAME HOST NAME as the page, not merely the same machine.
# Cookies are scoped by host, so a page on `localhost` talking to an API on
# `127.0.0.1` cannot read the CSRF cookie and the session cookie is never sent
# back. Set this only if the API really is somewhere else; leaving it unset
# derives the same host as the page, which is correct by construction.
VITE_API_BASE_URL=http://localhost:8000
