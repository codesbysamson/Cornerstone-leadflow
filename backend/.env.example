# Copy this file to .env and adjust for your machine.
# .env is git-ignored and must never be committed with real credentials.

# PostgreSQL connection string used by the API and by Alembic.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadflow

# Optional: run the test suite against a real PostgreSQL test database
# instead of the default isolated in-memory SQLite database.
# The target schema is dropped and recreated on every test session.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadflow_test

# Browser origins allowed to call this API. Needed for local development
# because the Vite dev server runs on a different origin to the API.
# Comma-separated, exact matches only — a wildcard is not used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
