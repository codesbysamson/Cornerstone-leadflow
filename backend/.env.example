# Copy this file to .env and adjust for your machine.
# .env is git-ignored and must never be committed with real credentials.
#
# On a hosting platform, set these as environment variables in the provider's
# dashboard instead of creating a .env file. Nothing else needs to change.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the API and by Alembic.
#
# This is a secret: it contains the database password. Never commit it.
#
# In production use the provider's *pooled* connection string (a hostname
# containing "-pooler") with `sslmode=require`. The pooled endpoint is what
# keeps a web service from exhausting the connection limit, and SSL is
# required for a managed database reached over the network.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadflow

# Optional: run the test suite against a real PostgreSQL test database
# instead of the default isolated in-memory SQLite database.
# The target schema is dropped and recreated on every test session.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadflow_test

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# "production" turns on every safe-by-default behaviour and is validated at
# startup. Anything else is treated as development. Use exactly:
#     APP_ENV=production
APP_ENV=development

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------

# Marks the session and CSRF cookies Secure, so the browser sends them over
# HTTPS only.
#
# Set to false only for local development: `Secure` cannot be used over
# http://localhost. In production it is mandatory — the API REFUSES TO START
# with APP_ENV=production unless this is true, because the session cookie would
# otherwise travel in the clear.
COOKIE_SECURE=false

# Absolute session lifetime in seconds. Sessions expire this long after login
# and are NOT extended by activity, so a session cannot be kept alive
# indefinitely. Default 43200 (12 hours).
# SESSION_MAX_AGE_SECONDS=43200

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Browser origins allowed to call this API. Needed because the frontend is
# served from a different origin to the API.
#
# Comma-separated, exact matches only. A wildcard is NOT used and cannot be:
# the API refuses to start if "*" appears here, because credentials are enabled
# and a wildcard would let any site on the internet make authenticated,
# cookie-bearing requests as a signed-in staff member.
#
# In production this is the frontend's public origin, e.g.
#     CORS_ORIGINS=https://www.example.com
#
# IMPORTANT: the frontend and API must share a site — the same registrable
# domain and scheme, e.g. `www.example.com` and `api.example.com`. The session
# cookie is SameSite=Lax, so a browser withholds it from a different site, and
# login would appear to succeed while every later request failed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Login throttling
# ---------------------------------------------------------------------------

# Failed sign-in attempts allowed per account inside the window below, after
# which further attempts are refused. The counter is stored in the database,
# so it survives restarts and is shared across server workers. It is cleared by
# a successful sign-in.
# Defaults: 5 failures, 15 minutes.
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Argon2id password hashing
# ---------------------------------------------------------------------------

# Deliberately slow and memory-hard parameters. The defaults are already
# strong. Lower them only to speed up the test suite, which does so through the
# environment.
#
# The API REFUSES TO START with APP_ENV=production if memory is below 32768 or
# time is below 2, so reduced test costs can never reach production.
#
# Defaults: 3 passes, 64 MiB, 4 lanes.
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=4
